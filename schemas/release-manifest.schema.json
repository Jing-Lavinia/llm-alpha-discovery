{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:llm-alpha-discovery:release-manifest:1.0",
  "title": "Public evidence release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "release_id",
    "generated_at_utc",
    "files"
  ],
  "properties": {
    "manifest_version": {"const": "1.0"},
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "generated_at_utc": {"type": "string", "format": "date-time"},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileRecord"}
    }
  },
  "$defs": {
    "fileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
